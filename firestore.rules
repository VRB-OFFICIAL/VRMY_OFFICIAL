rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['kokomona946@gmail.com', 'kokomina946@gmail.com'];
    }

    // only this one account — NOT kokomina946@gmail.com, even though it's
    // otherwise a full admin — can bypass the "vrb" lock below.
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'kokomona946@gmail.com';
    }

    // blocks "dev", "owner", "admin", "developer", "helper" (any case, anywhere
    // in the name) from being claimed by anyone except the two admin emails.
    function isReservedUsername(name) {
      return name.lower().matches('.*(dev|owner|admin|developer|helper).*');
    }

    // blocks "vrb" (any case, anywhere in the name) for absolutely everyone
    // except kokomona946@gmail.com.
    function isVrbLocked(name) {
      return name.lower().matches('.*vrb.*');
    }

    // combined check used everywhere a username/roblox value is validated:
    // ordinary reserved words need admin, "vrb" needs the super admin.
    function nameAllowed(name) {
      return (!isReservedUsername(name) || isAdmin())
          && (!isVrbLocked(name) || isSuperAdmin());
    }

    // role/displayName check: ordinary members can only ever have role "member",
    // exactly. Only an admin can set anything else (that's how you promote
    // someone) — and even for an admin, the value must pass nameAllowed()
    // (blocks the same reserved words / vrb rule as usernames) and must not
    // be a name someone has claimed in the usernames/robloxNames registries.
    function profileTextAllowed(text) {
      return nameAllowed(text)
          && !exists(/databases/$(database)/documents/usernames/$(text.lower()))
          && !exists(/databases/$(database)/documents/robloxNames/$(text.lower()));
    }

    // the caller's own (unverified, self-reported) Roblox username, or null
    // if they haven't set one. Used so chat/DM messages can only carry the
    // Roblox tag that's actually on the sender's own profile — no spoofing.
    function callerRoblox() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roblox', null);
    }

    // has this Roblox name been claimed (reserved exclusively) by an admin
    // via the robloxNames registry below?
    function robloxClaimed(name) {
      return exists(/databases/$(database)/documents/robloxNames/$(name.lower()));
    }

    // is the caller the one who claimed this Roblox name?
    function ownsRobloxClaim(name) {
      return get(/databases/$(database)/documents/robloxNames/$(name.lower())).data.uid == request.auth.uid;
    }

    // a Roblox name is settable by the caller if it isn't claimed at all,
    // or it's claimed by the caller themselves.
    function robloxNameAvailable(name) {
      return !robloxClaimed(name) || ownsRobloxClaim(name);
    }

    // is the caller the one who claimed this username?
    function ownsUsernameClaim(uname) {
      return get(/databases/$(database)/documents/usernames/$(uname.lower())).data.uid == request.auth.uid;
    }

    // a username is settable by the caller if it isn't claimed at all,
    // or it's claimed by the caller themselves.
    function usernameAvailable(uname) {
      return !exists(/databases/$(database)/documents/usernames/$(uname.lower())) || ownsUsernameClaim(uname);
    }

    // chat: read is open to everyone, but posting requires a signed-in,
    // verified username — the posted name must match the caller's own.
    match /messages/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.name ==
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.isAdmin == isAdmin()
                    && (!('roblox' in request.resource.data)
                        || request.resource.data.roblox == callerRoblox());
      allow update, delete: if isAdmin();
    }

    // kills leaderboard: everyone can view, only admin can add/edit/delete
    match /leaderboard_kills/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // skill rank leaderboard: everyone can view, only admin can add/edit/delete
    match /leaderboard_skill/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // user profiles: no email is ever stored or exposed here.
    // the permanent username can never change UNLESS the new value is a
    // name the caller has already claimed for themselves in the usernames
    // registry (an admin's own reservation, or their currently-claimed name) —
    // that's what lets an admin switch to a reserved name they own.
    // reserved words are blocked in both fields unless the caller is admin;
    // "vrb" is blocked for everyone except kokomona946@gmail.com specifically.
    // displayName/role/photo are freely editable profile extras — displayName
    // and role are just descriptive text (not identity), and photo is a
    // base64 data URL capped well under Firestore's 1MB doc limit.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && (!('username' in request.resource.data)
                        || nameAllowed(request.resource.data.username))
                    && (!('roblox' in request.resource.data)
                        || (request.resource.data.roblox is string
                            && request.resource.data.roblox.size() <= 24
                            && nameAllowed(request.resource.data.roblox)
                            && robloxNameAvailable(request.resource.data.roblox)))
                    && (!('displayName' in request.resource.data)
                        || (request.resource.data.displayName is string
                            && request.resource.data.displayName.size() <= 40
                            && (isAdmin() || request.resource.data.displayName.size() == 0)
                            && (request.resource.data.displayName.size() == 0
                                || profileTextAllowed(request.resource.data.displayName))))
                    && (!('role' in request.resource.data)
                        || (request.resource.data.role is string
                            && request.resource.data.role.size() <= 40
                            && (isAdmin()
                                ? profileTextAllowed(request.resource.data.role)
                                : request.resource.data.role == 'Member')))
                    && (!('photo' in request.resource.data)
                        || (request.resource.data.photo is string
                            && request.resource.data.photo.size() <= 700000));
      allow update: if request.auth != null && request.auth.uid == uid
                    && (!('username' in resource.data)
                        || request.resource.data.username == resource.data.username
                        || (isAdmin() && usernameAvailable(request.resource.data.username)))
                    && (!('username' in request.resource.data)
                        || nameAllowed(request.resource.data.username))
                    // roblox is unverified and freely editable by the owner,
                    // unlike the permanent username above — but reserved words
                    // and admin-claimed names (see robloxNames below) are blocked.
                    && (!('roblox' in request.resource.data)
                        || (request.resource.data.roblox is string
                            && request.resource.data.roblox.size() <= 24
                            && nameAllowed(request.resource.data.roblox)
                            && robloxNameAvailable(request.resource.data.roblox)))
                    // displayName: ordinary members can only ever clear it or
                    // leave it untouched — only an admin can set real text,
                    // and it's still checked against reserved words/vrb/claims.
                    && (!('displayName' in request.resource.data)
                        || request.resource.data.displayName == resource.data.get('displayName', '')
                        || (isAdmin()
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() <= 40
                            && (request.resource.data.displayName.size() == 0
                                || profileTextAllowed(request.resource.data.displayName))))
                    // role: ordinary members are locked to exactly "Member".
                    // only an admin can promote someone to anything else —
                    // that's the deliberate "I raise their rank" mechanism.
                    && (!('role' in request.resource.data)
                        || request.resource.data.role == resource.data.get('role', 'Member')
                        || (isAdmin()
                            && request.resource.data.role is string
                            && request.resource.data.role.size() <= 40
                            && profileTextAllowed(request.resource.data.role)))
                    && (!('photo' in request.resource.data)
                        || (request.resource.data.photo is string
                            && request.resource.data.photo.size() <= 700000));

      // promotion path: lets an admin change ONLY someone else's role,
      // and nothing else on their profile — this is the "raise their rank"
      // mechanism. The role must still pass the same reserved-word/vrb/
      // claimed-name checks as everywhere else.
      allow update: if isAdmin()
                    && request.auth.uid != uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
                    && request.resource.data.role is string
                    && request.resource.data.role.size() <= 40
                    && profileTextAllowed(request.resource.data.role);
    }

    // username registry: one doc per lowercase username, permanently claimed.
    // "create" only succeeds if nobody already owns that name. It can never
    // be updated, so a claimed name's owner never changes hands silently —
    // but an admin can delete (unclaim) any entry, freeing that name back up
    // for anyone to claim, including a different admin-owned reservation.
    // reserved words are blocked unless the caller is admin; "vrb" is blocked
    // unless the caller is kokomona946@gmail.com specifically.
    match /usernames/{uname} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/usernames/$(uname))
                    && nameAllowed(uname);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Roblox name claims: lets an admin reserve any number of Roblox
    // usernames exclusively for themselves (separate from the actual
    // 'roblox' field on their own /users profile, which can only hold one
    // at a time). While a name is claimed here, robloxNameAvailable()
    // blocks everyone else from setting it as their own 'roblox' value.
    // Only admins can create or delete claims; deleting one unclaims it.
    // "vrb" claims are further restricted to kokomona946@gmail.com only.
    match /robloxNames/{name} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
                    && (!isVrbLocked(name) || isSuperAdmin())
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/robloxNames/$(name));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // parent DM doc: holds participants + a preview, so each user can list
    // their own conversation history without searching every time.
    match /dms/{convoId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create, update: if request.auth != null
                            && convoId.split('_').size() == 2
                            && convoId.split('_').hasAny([request.auth.uid])
                            && request.resource.data.participants == convoId.split('_');
      allow delete: if false;
    }

    // private 1-on-1 DMs. Convo id is "<uidA>_<uidB>" (sorted), so only the
    // two participants' uids ever appear in it — anyone else is rejected.
    match /dms/{convoId}/messages/{msgId} {
      allow read: if request.auth != null
                  && convoId.split('_').size() == 2
                  && convoId.split('_').hasAny([request.auth.uid]);
      allow create: if request.auth != null
                    && convoId.split('_').size() == 2
                    && convoId.split('_').hasAny([request.auth.uid])
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.isAdmin == isAdmin()
                    && (!('senderRoblox' in request.resource.data)
                        || request.resource.data.senderRoblox == callerRoblox());
      allow update, delete: if false;
    }
  }
}
