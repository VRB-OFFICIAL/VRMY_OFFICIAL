rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['kokomona946@gmail.com', 'kokomina946@gmail.com'];
    }

    // chat: anyone can read and post, only admin can edit/delete messages
    match /messages/{id} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // kills leaderboard: everyone can view, only admin can add/edit/delete
    match /leaderboard_kills/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // skill rank leaderboard: everyone can view, only admin can add/edit/delete
    match /leaderboard_skill/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // user directory: lets signed-in people look each other up by email to start a DM.
    // each user can only write their own profile document.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // private 1-on-1 DMs. Convo id is "<uidA>_<uidB>" (sorted), so only the
    // two participants' uids ever appear in it — anyone else is rejected.
    match /dms/{convoId}/messages/{msgId} {
      allow read: if request.auth != null
                  && convoId.split('_').size() == 2
                  && convoId.split('_').hasAny([request.auth.uid]);
      allow create: if request.auth != null
                    && convoId.split('_').size() == 2
                    && convoId.split('_').hasAny([request.auth.uid])
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;
      allow update, delete: if false;
    }
  }
}
